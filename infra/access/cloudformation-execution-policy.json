{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageGosbloBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::gosblo-deployment-913498135252-ap-southeast-2",
        "arn:aws:s3:::gosblo-deployment-913498135252-ap-southeast-2/*",
        "arn:aws:s3:::gosblo-production-*"
      ]
    },
    {
      "Sid": "ManageContactRole",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::913498135252:role/gosblo-production-ContactRole-*"
    },
    {
      "Sid": "PassContactRoleToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::913498135252:role/gosblo-production-ContactRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageContactFunction",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:ap-southeast-2:913498135252:function:gosblo-production-contact"
    },
    {
      "Sid": "ManageContactLogs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:ap-southeast-2:913498135252:log-group:/aws/lambda/gosblo-production-contact:*"
    },
    {
      "Sid": "ManageContactApi",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": "arn:aws:apigateway:ap-southeast-2::/apis*"
    },
    {
      "Sid": "ManageCloudFrontResources",
      "Effect": "Allow",
      "Action": "cloudfront:*",
      "Resource": "*"
    }
  ]
}
